# 后端配置（复制为 .env 后修改）。前缀统一 DOCREVIEW_，全部可选，有默认值。
# 用法：cp .env.example .env

# --- 开发服务器（uv run python -m app 读取）---
DOCREVIEW_HOST=127.0.0.1
DOCREVIEW_PORT=8000
DOCREVIEW_RELOAD=true

# --- 模型网关（OpenAI 兼容；不填 API_KEY 时自动降级到规则兜底）---
DOCREVIEW_LLM_BASE_URL=https://api.openai.com/v1
DOCREVIEW_LLM_API_KEY=
DOCREVIEW_LLM_MODEL=gpt-4o-mini
DOCREVIEW_LLM_TEMPERATURE=0.2
DOCREVIEW_LLM_MAX_TOKENS=4096
DOCREVIEW_LLM_TIMEOUT=60

# --- 异步执行后端（留空=进程内线程；设置则启用 Celery+Redis）---
# DOCREVIEW_CELERY_BROKER_URL=redis://localhost:6379/0
# DOCREVIEW_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS（前端地址，逗号分隔）---
DOCREVIEW_CORS_ORIGINS=http://localhost:5174
